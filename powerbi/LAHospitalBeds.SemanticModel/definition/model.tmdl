model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataFolder","GetFile","Hospitals","Weeks","Tracts"]
annotation __PBI_TimeIntelligenceEnabled = 0

ref table Hospitals
ref table Weeks
ref table Tracts

ref cultureInfo en-US
